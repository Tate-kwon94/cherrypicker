{
  // Cloudflare Worker 배포 기준 설정.
  //
  // 이 파일이 유일한 배포 설정 원본이다. 예전에는 vite.config.ts 안의
  // 인라인 객체가 이 자리를 대신했는데, @cloudflare/vite-plugin 의 `config`
  // 옵션은 독립 설정이 아니라 병합 customizer라서 파일 설정을 덮어쓴다.
  // 그 상태로 파일을 추가하면 설정 원본이 셋이 되고 어느 쪽이 이겼는지
  // 산출물을 열어보기 전에는 알 수 없다.
  //
  // binding 이름은 .openai/hosting.json 이 제어하므로, 두 파일이 어긋나면
  // `npm run check:config` 가 빌드 전에 실패시킨다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cherrypicker-price-guide",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      // hosting.json 의 "d1" 값과 일치해야 한다.
      "binding": "DB",
      "database_name": "site-creator-d1",
      // 제어면이 실제 값을 주입한다. placeholder 가 배포까지 살아 있으면
      // cold-start 리허설에서 잡아야 한다 (DEPLOY-01b).
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}
