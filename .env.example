# Canonical origin. Metadata falls back to the request host when unset,
# but robots and sitemap only emit relative paths — a forged Host must
# never become the site's declared canonical URL. Read from both
# process.env and the Worker binding.
NEXT_PUBLIC_SITE_URL=

# Comma-separated ChatGPT account emails allowed to manage verified prices.
ADMIN_EMAILS=

# Kakao cart import. Three separate secrets — reusing one value for two of
# them is rejected, because a leaked auth token would otherwise also decrypt
# stored URLs and reverse the user hash.
# Sent only as the x-cherrypicker-skill-token header, never in a query string.
KAKAO_SKILL_TOKEN=
# AES key material for stored image URLs. Rotating this expires any link that
# has not been opened yet; the TTL is 10 minutes, so wait one TTL after rotating.
KAKAO_URL_ENCRYPTION_KEY=
# Pepper for the one-way Kakao user hash used to rate-limit per user.
KAKAO_USER_HASH_PEPPER=

# Runtime feature flags. Read at request time on the server only.
# Each one gates a real code path; a flag with nothing to gate is not kept.
# Every flag is fail-closed: absent, misspelled or non-"true" values are off.
# NEXT_PUBLIC_* is not usable here — it is frozen into the build output and
# compiles to `{}` in the client bundle, so it cannot switch a feature off.
MONETIZATION_ENABLED=false
KAKAO_IMPORT_ENABLED=false
ALCOHOL_COMMERCE_ENABLED=false
AUTO_CONFIRM_ENABLED=false
ADMIN_UI_ENABLED=false

# Google AdSense. Only read when MONETIZATION_ENABLED is exactly "true".
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME_CONTENT=
